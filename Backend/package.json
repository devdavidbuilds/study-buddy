{
  "name": "study-buddy-backend",
  "version": "1.0.0",
  "description": "Backend for Study Buddy - Academic Learning Platform",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "import:courses": "node scripts/importCourses.js",
    "content:enrich": "node scripts/enrichCourses.js",
    "content:status": "node scripts/enrichCourses.js --status",
    "content:rollback": "node scripts/rollbackCourseContent.js",
    "catalog:audit": "node scripts/auditCatalog.js",
    "catalog:cleanup": "node scripts/cleanupCatalog.js",
    "domains:sync": "node scripts/updateCourseDomains.js",
    "ai:check": "node scripts/checkAiModel.js"
  },
  "keywords": ["study-buddy", "express", "mongodb", "nodejs"],
  "author": "David Prince",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.2",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.3",
    "pdfkit": "^0.17.2",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
