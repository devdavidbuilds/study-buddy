# Server Configuration
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=<long random string>
FRONTEND_URLS=http://localhost:5173

FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------
# Gemini — AI Tutor (/api/chatbot) and course content pipeline
# Get a key at https://aistudio.google.com/apikey. Never commit the real value.
# ---------------------------------------------------------------
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-latest

# Provider override (default: gemini when GEMINI_API_KEY is set, otherwise none).
# For an openai-compatible provider (Groq, OpenRouter, Ollama) set all three:
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=
LLM_RPM=10
LLM_THINKING=low
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=4

# Optional per-feature overrides
# TUTOR_LLM_PROVIDER=
# AI Tutor model. Defaults to gemini-flash-lite-latest (~2 s per reply; full Flash
# models took 30-40 s on the free tier, past the tutor's 30 s timeout).
# TUTOR_LLM_MODEL=gemini-flash-lite-latest
# TUTOR_LLM_TIMEOUT_MS=30000
# CONTENT_LLM_PROVIDER=
# CONTENT_LLM_MODEL=
# CONTENT_LLM_RPM=

# Optional LLM cost estimates
# LLM_PRICE_INPUT_PER_M=
# LLM_PRICE_OUTPUT_PER_M=

# ---------------------------------------------------------------
# Study Buddy Fine-Tuned Model — Google Colab
# ---------------------------------------------------------------
STUDY_BUDDY_MODEL_URL=https://YOUR-NGROK-URL/generate
STUDY_BUDDY_API_TOKEN=YOUR_STUDY_BUDDY_SECRET

# ---------------------------------------------------------------
# Judge0 — Code Lab
# ---------------------------------------------------------------
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

# ---------------------------------------------------------------
# Assignment PDF Submissions
# ---------------------------------------------------------------
ASSIGNMENT_PDF_MAX_MB=10
# Where submitted PDFs are kept:
#   gridfs (default) — inside MongoDB (uses MONGODB_URI; survives redeploys on Render etc.)
#   local            — on this server's disk (only persistent if the disk is)
SUBMISSION_STORAGE=gridfs
# SUBMISSION_UPLOAD_DIR=   # local storage folder (and where pre-GridFS PDFs are read from)

# ---------------------------------------------------------------
# Lecture Materials (PDF / PPT / PPTX) — always stored in MongoDB GridFS
# ---------------------------------------------------------------
LECTURE_MATERIAL_MAX_MB=25