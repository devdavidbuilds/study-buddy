# Backend origin, without /api.
# Leave it unset locally: `npm run dev` then uses the local backend at
# http://localhost:5000 (start it with `npm run dev` in Backend/).
# Set it to use another backend from your machine, and on Vercel set it to
# the Render backend URL, e.g. https://study-buddy-backend.onrender.com
# VITE_API_BASE_URL=https://study-buddy-91gv.onrender.com
